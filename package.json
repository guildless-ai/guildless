{
  "name": "guildless",
  "version": "0.1.0",
  "description": "Evidence-gated AI company operating system with a deterministic completion gate.",
  "type": "module",
  "bin": {
    "guildless": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "guildless.example.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "eslint src test",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agents",
    "company-operating-system",
    "money-intelligence",
    "capability-acquisition",
    "verification",
    "cli",
    "ci",
    "completion-gate"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guildless-ai/guildless.git"
  },
  "bugs": {
    "url": "https://github.com/guildless-ai/guildless/issues"
  },
  "homepage": "https://github.com/guildless-ai/guildless#readme",
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.6",
    "eslint": "^10.8.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  }
}
